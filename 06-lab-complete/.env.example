# Sao chép thành .env (đã nằm trong .gitignore): cp .env.example .env
# KHÔNG ghi secret thật vào file này.

PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Khóa API client phải gửi trong header X-API-Key. Để trống = từ chối mọi request.
AGENT_API_KEY=

# Redis lưu rate limit và chi phí. Trong docker compose, REDIS_URL được đặt sẵn.
REDIS_URL=redis://localhost:6379/0

# Giới hạn request mỗi API key trong 60 giây
RATE_LIMIT_PER_MINUTE=10

# Ngân sách (USD); vượt thì /ask trả 402
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
